#include "bmx160.h"

uint8_t bmx160_read8(BMX160_t* obj, uint16_t reg)
{
    uint8_t value;
//    printf("\nReading at address: %d",obj->address);
    if(HAL_I2C_Mem_Read(obj->hi2c, obj->address<<1,
                     reg, I2C_MEMADD_SIZE_16BIT,
                     &value, 1, 100)==HAL_OK){
//    	printf("\nRead Success!");
    }else{
//    	printf("\nRead failure!");
    }

    return value;
}

BMX160_Status bmx160_write8bit(BMX160_t* obj,uint16_t reg,uint8_t value){
	if(HAL_I2C_Mem_Write(obj->hi2c,obj->address<<1,reg,I2C_MEMADD_SIZE_16BIT,&value,1,100)==HAL_OK){
		printf("\nWrite Success");
		return BMX160_OK;
	}else{
		printf("\nWrite Failure");

		return BMX160_ERROR;
	}
}

void bmx160_attach(BMX160_t* obj,I2C_HandleTypeDef* hi2c){
	obj->hi2c=hi2c;
	obj->address=BMX160_DEFAULT_ADDR;
}

void bmx160_begin(BMX160_t* obj){

	//	Soft Reset
	bmx160_write8bit(obj,BMX160_COMMAND_REG_ADDR, BMX160_SOFT_RESET_CMD);

	bmx160_write8bit(obj,BMX160_COMMAND_REG_ADDR, 0x11);
	HAL_delay(50);
	/* Set gyro to normal mode */
	bmx160_write8bit(obj,BMX160_COMMAND_REG_ADDR, 0x15);
	HAL_delay(100);
	/* Set mag to normal mode */
	bmx160_write8bit(obj,BMX160_COMMAND_REG_ADDR, 0x19);
	HAL_delay(10);

	//	Magn Conf
    bmx160_write8bit(obj,BMX160_MAGN_IF_0_ADDR, 0x80);
    HAL_delay(50);
    // Sleep mode
    bmx160_write8bit(obj,BMX160_MAGN_IF_3_ADDR, 0x01);
    bmx160_write8bit(obj,BMX160_MAGN_IF_2_ADDR, 0x4B);
    // REPXY regular preset
    bmx160_write8bit(obj,BMX160_MAGN_IF_3_ADDR, 0x04);
    bmx160_write8bit(obj,BMX160_MAGN_IF_2_ADDR, 0x51);
    // REPZ regular preset
    bmx160_write8bit(obj,BMX160_MAGN_IF_3_ADDR, 0x0E);
    bmx160_write8bit(obj,BMX160_MAGN_IF_2_ADDR, 0x52);

    bmx160_write8bit(obj,BMX160_MAGN_IF_3_ADDR, 0x02);
    bmx160_write8bit(obj,BMX160_MAGN_IF_2_ADDR, 0x4C);
    bmx160_write8bit(obj,BMX160_MAGN_IF_1_ADDR, 0x42);
    bmx160_write8bit(obj,BMX160_MAGN_CONFIG_ADDR, 0x08);
    bmx160_write8bit(obj,BMX160_MAGN_IF_0_ADDR, 0x03);
    HAL_delay(50);
}

BMX160_Status bmx160_CheckAlive(BMX160_t* obj){
	uint8_t value;
	value = bmx160_read8(obj,BMX160_CHIPID);
	if(value==BMX160_DEFAULT_CHIPID){
		return BMX160_OK;
	}else{
		return BMX160_ERROR;
	}
}
